{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "description": "Read-only дашборд ads-autopilot (ТЗ §3.2, приёмка §9.5)",
  "scripts": {
    "db:generate": "prisma generate --config ./prisma.config.ts",
    "dev": "pnpm db:generate && next dev --port 3001",
    "build": "pnpm db:generate && next build",
    "start": "next start --port 3001",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "prisma": "7.9.1",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
