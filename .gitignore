node_modules/
dist/
.env
# Всё, что рядом с .env: web/.env.local, дампы, временные копии вида .env.aB12Cd,
# которые rollback.sh создаёт при правке. Каталог деплоя — это git-checkout, и
# такая копия секретов иначе попадает в `git status` и в `git add -A`.
.env.*
!.env.example
*.log
.DS_Store
.vscode/
.idea/
coverage/
*.tsbuildinfo

# История деплоев пишется на сервере: у каждой машины она своя.
.deploy-history

# Дамп Redis, если сервер случайно запустили из корня проекта.

# Черновики агентов в корне репозитория. Заводятся, чтобы прогнать гипотезу, и
# живут минуты — но за проект уже трижды уезжали в чужой коммит через `git add -A`
# или попадали под чужую уборку. Игнорируем именно корень: в `src/` файл с таким
# именем — это нормальный исходник, и прятать его нельзя.
/probe-*
/dump.rdb
