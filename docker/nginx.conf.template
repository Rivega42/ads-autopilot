# Reverse-proxy прод-стека. Два имени: API и дашборд.
#
# Это шаблон: официальный образ nginx прогоняет /etc/nginx/templates/*.template
# через envsubst и кладёт результат в /etc/nginx/conf.d. Подставляются только
# переменные, объявленные в окружении, поэтому $host и $remote_addr остаются
# нетронутыми — их nginx раскрывает сам. Домены задаются в .env деплоя.

# Заголовок Connection ставится по факту апгрейда, а не всем подряд: с жёстким
# `Connection "upgrade"` keep-alive до апстрима не живёт вообще.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# Встроенный DNS докера. Без `resolver` nginx резолвит `api` и `web` один раз, при
# разборе конфига, и держит адрес до перезапуска — а `deploy.sh` пересоздаёт api и
# web, не трогая nginx (образ nginx между выкатами не меняется). Адрес контейнера
# при пересоздании меняется не всегда, поэтому отказ выходит через раз: в замере
# три пересоздания подряд дали 502, 200, 502 при живом api. Наружу это выглядит как
# лежащий API при зелёном деплое.
#
# `valid=10s` — на столько кешируется ответ DNS; `ipv6=off`, потому что сети compose
# по умолчанию без IPv6, а без этой опции nginx получил бы AAAA-запрос и ждал отказа.
resolver 127.0.0.11 valid=10s ipv6=off;

# Общий редирект на HTTPS. ACME-челлендж обязан остаться на 80: certbot renew
# ходит по HTTP, и без этого исключения продление сертификата упадёт.
server {
  listen 80;
  server_name _;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${API_DOMAIN};

  ssl_certificate /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy no-referrer always;

  client_max_body_size 2m;

  location / {
    # Адрес апстрима через переменную — только так nginx резолвит имя на каждый
    # запрос, а не единожды при старте (см. resolver выше). URI при этом уходит
    # неизменным: у proxy_pass с переменной и без пути так и задумано.
    set $api_upstream http://api:3000;
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${DASHBOARD_DOMAIN};

  ssl_certificate /etc/letsencrypt/live/${DASHBOARD_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DASHBOARD_DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy no-referrer always;

  # Второй basic-auth здесь намеренно не ставится: дашборд закрывается сам
  # (web/middleware.ts), и два пароля на одну дверь только путают. Если понадобится
  # закрыть его на уровне прокси — DASHBOARD_AUTH_MODE=proxy плюс auth_basic тут.
  location / {
    set $web_upstream http://web:3001;
    proxy_pass $web_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}
