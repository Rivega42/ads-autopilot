{
  // Тесты не покрывались тайпчеком вообще: корневой конфиг включает только
  // `src/**`, а `tests/**` — почти три сотни сценариев и вся их обвязка —
  // проверялись лишь тем, что витест их запустит. Из-за этого пропущенный
  // экспорт в файле поддержки доживал до CI и падал там как TypeError.
  //
  // Отдельный конфиг, а не расширение корневого: у корневого `rootDir` — `src`,
  // и он обязан таким остаться, иначе сборка разложит `dist` иначе.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true
  },
  //
  // Здесь же четыре файла в корне и в `prisma/`: они настоящий TypeScript, но не
  // попадают ни в `src/**`, ни в `tests/**`. Хуже всех был `prisma/seed.ts` —
  // он ходит в БД и не проверялся ничем.
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "prisma/seed.ts",
    "prisma.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts"
  ]
}
