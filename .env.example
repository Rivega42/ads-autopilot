# ─────────────────────────────────────────────────────────────
# ads-autopilot — переменные окружения (пример)
# ─────────────────────────────────────────────────────────────
# Скопировать в .env и заполнить своими значениями.
# .env НИКОГДА не коммитить в git.
# ─────────────────────────────────────────────────────────────

# ── База данных
DATABASE_URL="postgresql://user:password@localhost:5432/ads_autopilot"
REDIS_URL="redis://localhost:6379"

# ── Шифрование креденшелов клиентов (32 байта base64)
# Обязателен: без него процесс не стартует. Значения по умолчанию нет намеренно —
# раньше оно было, и им оказались 32 нулевых байта из открытых исходников.
# Сгенерировать: openssl rand -base64 32
# Компрометация этого ключа равна компрометации всех кабинетов всех клиентов;
# процедура ротации — docs/security.md.
CREDENTIALS_ENCRYPTION_KEY=""

# ── Доступы клиентов к кабинетам
# Здесь их нет и быть не может: токены клиентов лежат в БД зашифрованными
# ключом выше, а заводятся командой
#   pnpm cli credentials set --client <id> --provider yandex_direct --apply
# (процедура целиком — docs/RUNBOOK.md, «Завести или заменить доступы клиента»).
# Секрет команда читает из stdin. Переменная ниже — разовый носитель на один
# запуск для systemd/CI, где трубы нет; она намеренно закомментирована:
# заполненная в .env, она держала бы токен кабинета в открытом файле постоянно
# и подменяла бы собой любой ввод с stdin при каждом запуске команды.
# ADS_CREDENTIAL_PAYLOAD=

# ── Telegram Bot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# ── LLM провайдеры
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
DEEPSEEK_API_KEY=""

# ── Yandex Direct API
YANDEX_OAUTH_CLIENT_ID=""
YANDEX_OAUTH_CLIENT_SECRET=""
YANDEX_DIRECT_USE_SANDBOX="true"  # false для production

# ── VK Реклама API
VK_ADS_CLIENT_ID=""
VK_ADS_CLIENT_SECRET=""

# ── Яндекс Метрика
YANDEX_METRIKA_TOKEN=""

# ── TikTok Marketing API (опционально)
TIKTOK_APP_ID=""
TIKTOK_APP_SECRET=""

# ── LinkedIn Marketing API (опционально)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# ── Meta Marketing API (опционально)
META_APP_ID=""
META_APP_SECRET=""

# ── Google Ads API (опционально)
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""

# ── Генерация изображений
KANDINSKY_API_KEY=""
# FusionBrain авторизуется парой: X-Key + X-Secret.
KANDINSKY_SECRET_KEY=""
YANDEXART_API_KEY=""
DALLE_API_KEY=""

# ── Генерация видео
RUNWAY_API_KEY=""
KANDINSKY_VIDEO_API_KEY=""

# ── Web-search / SEO
SERPAPI_KEY=""
WORDSTAT_TOKEN=""

# ── Предохранители
# DRY_RUN=true — система читает кабинеты и присылает карточки, но ничего в них
# не меняет. Выключать только после успешного прогона в песочнице (docs/DEPLOY.md §8).
DRY_RUN="true"
# Доли, а не проценты: 0.3 = 30%. Значение больше единицы роняет старт — «30» в поле
# доли означало бы 3000%, то есть снятый предохранитель с видом настроенного.
MAX_BID_CHANGE_PCT="0.3"          # доля, не проценты: 0.3 = ±30% за раз
DAILY_BUDGET_HARD_LIMIT_MULT="1.2"

# ── Дашборд
# Пусто и без DASHBOARD_AUTH_MODE=proxy — дашборд отвечает 503. Отказ по умолчанию.
DASHBOARD_USER="admin"
DASHBOARD_PASSWORD=""
DASHBOARD_AUTH_MODE=""            # proxy — если авторизацию держит nginx/Cloudflare

# ── Прод-стек (docker-compose.prod.yml)
POSTGRES_USER="ads"
POSTGRES_PASSWORD=""
POSTGRES_DB="ads_autopilot"
API_DOMAIN=""                     # api.example.ru
DASHBOARD_DOMAIN=""               # dash.example.ru
APP_IMAGE=""                      # пусто — берётся образ из GHCR
WEB_IMAGE=""

# ── Деплой
DEPLOY_HOST=""
DEPLOY_PATH="/root/projects/ads-autopilot"

# ── Сид демо-данных
SEED_ADMIN_TG_ID=""

# ── Конфигурация приложения
NODE_ENV="development"
PORT="3000"
LOG_LEVEL="info"                  # debug | info | warn | error
TZ="Europe/Moscow"

# ── Approval flow
APPROVAL_TIMEOUT_HOURS="2"
# Доля, не проценты: 0.2 = изменения больше 20% уходят на апрув. Порог общий для
# бюджета и ставки, несмотря на имя переменной. Раньше здесь стояло «20», и код
# рядом держал 0.2 своей константой; прочитанное как доля, «20» дало бы порог 2000%
# и сняло бы апрув со всех изменений сразу — поэтому теперь такое значение роняет старт.
BUDGET_CHANGE_THRESHOLD_PCT="0.2"
