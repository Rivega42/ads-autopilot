# ─────────────────────────────────────────────────────────────
# ads-autopilot — переменные окружения (пример)
# ─────────────────────────────────────────────────────────────
# Скопировать в .env и заполнить своими значениями.
# .env НИКОГДА не коммитить в git.
# ─────────────────────────────────────────────────────────────

# ── База данных
DATABASE_URL="postgresql://user:password@localhost:5432/ads_autopilot"
REDIS_URL="redis://localhost:6379"

# ── Шифрование креденшелов клиентов (32 байта base64)
# Сгенерировать: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=""

# ── Telegram Bot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# ── LLM провайдеры
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
DEEPSEEK_API_KEY=""

# ── Yandex Direct API
YANDEX_OAUTH_CLIENT_ID=""
YANDEX_OAUTH_CLIENT_SECRET=""
YANDEX_DIRECT_USE_SANDBOX="true"  # false для production

# ── VK Реклама API
VK_ADS_CLIENT_ID=""
VK_ADS_CLIENT_SECRET=""

# ── Яндекс Метрика
YANDEX_METRIKA_TOKEN=""

# ── TikTok Marketing API (опционально)
TIKTOK_APP_ID=""
TIKTOK_APP_SECRET=""

# ── LinkedIn Marketing API (опционально)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# ── Meta Marketing API (опционально)
META_APP_ID=""
META_APP_SECRET=""

# ── Google Ads API (опционально)
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""

# ── Генерация изображений
KANDINSKY_API_KEY=""
# FusionBrain авторизуется парой: X-Key + X-Secret.
KANDINSKY_SECRET_KEY=""
YANDEXART_API_KEY=""
DALLE_API_KEY=""

# ── Генерация видео
RUNWAY_API_KEY=""
KANDINSKY_VIDEO_API_KEY=""

# ── Web-search / SEO
SERPAPI_KEY=""
WORDSTAT_TOKEN=""

# ── Деплой
DEPLOY_HOST=""
DEPLOY_PATH="/root/projects/ads-autopilot"

# ── Сид демо-данных
SEED_ADMIN_TG_ID=""

# ── Конфигурация приложения
NODE_ENV="development"
PORT="3000"
LOG_LEVEL="info"                  # debug | info | warn | error
TZ="Europe/Moscow"

# ── Approval flow
APPROVAL_TIMEOUT_HOURS="2"
BUDGET_CHANGE_THRESHOLD_PCT="20"  # изменения >20% требуют апрув
