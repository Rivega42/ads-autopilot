# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=3000
TZ=Europe/Moscow

# ─── Datastores ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://adsautopilot:adsautopilot@localhost:5432/adsautopilot?schema=public
REDIS_URL=redis://localhost:6379

# ─── Secrets ────────────────────────────────────────────────────────────────
# 32-byte key, hex-encoded (64 hex chars). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ─── Safety rails (see docs/PLAN.md, EPIC-05) ───────────────────────────────
# Global kill-switch: when true no write ever reaches an ad platform.
DRY_RUN=true
# Max relative bid change applied in a single day, 0.30 = 30%
MAX_BID_CHANGE_PCT=0.30
# Daily budget hard ceiling as a multiple of the client's target budget
DAILY_BUDGET_HARD_LIMIT_MULT=1.20
# Pending approvals expire after this many minutes
APPROVAL_TTL_MINUTES=120

# ─── Telegram ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ─── Yandex Direct ──────────────────────────────────────────────────────────
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
# true -> https://api-sandbox.direct.yandex.com/json/v5/
YANDEX_DIRECT_SANDBOX=true
# Stop issuing calls when remaining units drop below this
YANDEX_UNITS_RESERVE=500

# ─── VK Реклама (ads.vk.ru) ─────────────────────────────────────────────────
VK_ADS_CLIENT_ID=
VK_ADS_CLIENT_SECRET=

# ─── Яндекс Метрика ─────────────────────────────────────────────────────────
METRIKA_OAUTH_TOKEN=

# ─── LLM providers ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ─── Image / video generation ───────────────────────────────────────────────
FUSIONBRAIN_API_KEY=
FUSIONBRAIN_SECRET_KEY=
YANDEX_ART_FOLDER_ID=
YANDEX_ART_IAM_TOKEN=

# ─── Optional channels (post-MVP adapters) ──────────────────────────────────
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
